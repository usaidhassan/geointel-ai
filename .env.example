# --- LLM access ---
# in my case 
AI_GATEWAY_API_KEY=your_key_here
# Model string format: "<provider>/<model>". Change only this to switch providers,
# e.g. "openai/gpt-5.4-mini" -> "groq/llama-3.3-70b-versatile" -> "google/gemini-2.5-flash"
LLM_MODEL=openai/gpt-5.4-mini

# --- Database (Postgres + pgvector) ---
# Local dev (matches docker-compose.yaml service "db"):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geointel
POSTGRES_USER=geointel
POSTGRES_PASSWORD=geointel

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- App ---
API_PORT=8000
#for multi llm rag
GROQ_API_KEY=your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=your_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# you can change models but make sure your provider should be at start like google/model_name.
RAG_MODELS=openai/gpt-5.4-mini,groq/llama-3.3-70b-versatile,google/gemini-3.5-flash-lite,openrouter/nvidia/nemotron-3-super-120b-a12b:free

AGENT_MODELS=openai/gpt-5.4-mini,groq/llama-3.3-70b-versatile,google/gemini-3.5-flash-lite,openrouter/nvidia/nemotron-3-super-120b-a12b:free

JUDGE_MODELS=google/gemini-3.5-flash-lite,groq/llama-3.3-70b-versatile,openrouter/nvidia/nemotron-3-super-120b-a12b:free